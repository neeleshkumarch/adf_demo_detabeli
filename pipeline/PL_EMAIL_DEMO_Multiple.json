{
	"name": "PL_EMAIL_DEMO_Multiple",
	"properties": {
		"activities": [
			{
				"name": "Send Email",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "prepare  logical body",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": "https://prod-73.southeastasia.logic.azure.com:443/workflows/ea673cc97e704e339c57f6dc00903227/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=kMmVgB7I6G9ITbX9I-yZiWMPd55b0SuYyP4Xx1q1us8",
					"body": {
						"value": "@variables('logical_apps_body')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "prepare  logical body",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "prepare_email_subject",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "prepare_email_body",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "logical_apps_body",
					"value": {
						"value": "{\"email_recepient\":\"@{pipeline().parameters.email_recepient}\",\n\"subject\":\"@{variables('email_subject')}\",\n\"body\":\"@variables('email_body')\"}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "prepare_email_subject",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_subject",
					"value": {
						"value": "Ingestion Completed",
						"type": "Expression"
					}
				}
			},
			{
				"name": "prepare_email_body",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_body",
					"value": {
						"value": "The ingestion process has been completed for all tables and\n below is the status\n @{pipeline().parameters.table_status}\n\n pipeline run id = @{pipeline().RunId}",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"email_recepient": {
				"type": "string"
			},
			"table_status": {
				"type": "array"
			}
		},
		"variables": {
			"logical_apps_body": {
				"type": "String"
			},
			"email_subject": {
				"type": "String"
			},
			"email_body": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-10-27T14:56:44Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}